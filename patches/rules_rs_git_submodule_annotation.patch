# Allow a Git crate to omit redundant submodules when its native inputs are
# supplied by separate, fully pinned source repositories. Preserve the default
# for other crates and reject inconsistent settings for a shared checkout.

diff --git a/rs/extensions.bzl b/rs/extensions.bzl
--- a/rs/extensions.bzl
+++ b/rs/extensions.bzl
@@ -106,6 +106,8 @@
             "archive_url": archive_url,
             "build_annotations": {},
             "commit": commit,
+            "init_submodules": annotation.git_init_submodules,
+            "recursive_init_submodules": annotation.git_init_submodules,
             "hub_name": hub.cfg.name,
             "patch_args": [],
             "patch_tool": "",
@@ -125,6 +127,9 @@
         ))

     # Git crates from the same commit share one checkout per hub.
+    if git_repo["init_submodules"] != annotation.git_init_submodules:
+        fail("Git crates from %s use incompatible git_init_submodules settings" % repo_name)
+
     if annotation.use_git:
         git_repo["use_git"] = True

@@ -1090,6 +1095,10 @@
         # "shallow_since": attr.string(
         #     doc = "An optional timestamp used for crates originating from a git repository instead of a crate registry. This flag optimizes fetching the source code.",
         # ),
+        "git_init_submodules": attr.bool(
+            doc = "Initialize Git submodules recursively. All crates sharing a Git checkout must agree.",
+            default = True,
+        ),
         "strip_prefix": attr.string(),
         "use_git": attr.bool(
             doc = "For a Git crate, fetch the complete Git checkout instead of a GitHub source archive. " +
